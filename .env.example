# Contact form workflow — server-side secrets only; never prefix with VITE_.
# The integration stays unavailable until both values are set in the local
# Cloudflare development environment and production Worker secrets.
N8N_CONTACT_WEBHOOK_URL=
N8N_CONTACT_WEBHOOK_TOKEN=
CONTACT_IDEMPOTENCY_TOKEN=

# Optional build-only credential for uploading production source maps to Sentry.
# Create it in Sentry with project:releases scope and never commit its value.
SENTRY_AUTH_TOKEN=
